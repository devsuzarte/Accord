# Copie para apps/api/.env se quiser mudar algo. Sem este arquivo, os padrões valem.

# Porta do servidor do sharescreen (o app usa 7870 quando o usuário não informa outra)
API_HOST=0.0.0.0
API_PORT=7870

# Entrada aberta só com um nome no canal "Geral" (até existirem contas). false desliga.
OPEN_JOIN=true

# LiveKit local. Os valores abaixo são do modo --dev (bun run livekit:dev).
# O pacote do servidor (bun run package:server) gera chaves próprias e ignora estes.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
